      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LOAD ESTIMATE\n(replace with your Part 2 numbers)\n\n1,000,000 users, 20% active daily\n= 200,000 daily active users\n\nReads: 20/user/day = 4M/day\n≈ 46/s average, ~500/s at peak\n\nWrites: 2/user/day = 400K/day\n≈ 5/s average, ~50/s at peak\n\nStorage: 1 KB/note ≈ 150 GB/year\nReads ≈ 10× writes → cache + replicas",
      "originalText": "LOAD ESTIMATE\n(replace with your Part 2 numbers)\n\n1,000,000 users, 20% active daily\n= 200,000 daily active users\n\nReads: 20/user/day = 4M/day\n≈ 46/s average, ~500/s at peak\n\nWrites: 2/user/day = 400K/day\n≈ 5/s average, ~50/s at peak\n\nStorage: 1 KB/note ≈ 150 GB/year\nReads ≈ 10× writes → cache + replicas",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle-53",
      "lineHeight": 1.25,
      "autoResize": true
